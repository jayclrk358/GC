{
  "name": "gamecentral",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,rt,worker -c blue,magenta,yellow \"pnpm --filter @gamecentral/web dev\" \"pnpm --filter @gamecentral/realtime dev\" \"pnpm --filter @gamecentral/worker dev\"",
    "build": "pnpm -r build",
    "start": "concurrently -k -n web,rt,worker \"pnpm --filter @gamecentral/web start\" \"pnpm --filter @gamecentral/realtime start\" \"pnpm --filter @gamecentral/worker start\"",
    "lint": "eslint . --max-warnings=0 && node scripts/check-i18n.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @gamecentral/web test:e2e",
    "db:generate": "pnpm --filter @gamecentral/db generate",
    "db:migrate": "pnpm --filter @gamecentral/db migrate",
    "db:seed": "pnpm --filter @gamecentral/db seed && pnpm --filter @gamecentral/auth seed:demo",
    "db:reset": "pnpm --filter @gamecentral/db reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
