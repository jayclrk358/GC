{
  "name": "gamecentral-desktop",
  "productName": "Game Central",
  "version": "1.1.0",
  "description": "Game Central for Windows: the Game Central website in its own window.",
  "author": "Game Central",
  "private": true,
  "main": "dist/main.js",
  "siteUrl": "https://gamecentral.app",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.gamecentral.desktop",
    "productName": "Game Central",
    "copyright": "Game Central",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": null,
    "files": [
      "dist/**/*.js",
      "static/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "en-GB",
      "es",
      "es-419",
      "fr",
      "de",
      "pt-BR",
      "pt-PT"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "GameCentral-Setup-${version}.exe",
      "shortcutName": "Game Central",
      "uninstallDisplayName": "Game Central",
      "include": "build/installer.nsh"
    }
  }
}
