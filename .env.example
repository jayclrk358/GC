# ─── Core ────────────────────────────────────────────────────────────────
# Public URL of the web app (used for auth callbacks, emails and CORS checks).
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://magnox:magnox@localhost:5432/magnox
# BullMQ requires maxmemory-policy noeviction; caches and rate limits want LRU. Use two instances
# in production. Locally both can point at the same Redis.
REDIS_QUEUE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
# Docker only: hosted Postgres/Redis instead of the bundled containers (used with
# docker-compose.external.yml; see the README). Put the database in the same region as the
# server, since every page runs a few dozen queries.
# EXTERNAL_DATABASE_URL=postgres://user:password@host:5432/magnox?sslmode=require
# Set to false for a pooled address in transaction mode (Neon "-pooler", Supabase port 6543).
# EXTERNAL_DATABASE_PREPARE=true
# EXTERNAL_REDIS_QUEUE_URL=rediss://default:password@host:6379
# EXTERNAL_REDIS_CACHE_URL=rediss://default:password@host:6379

# ─── Realtime ────────────────────────────────────────────────────────────
REALTIME_PORT=3001
# Where the browser connects for Socket.IO. Leave empty to use the same origin (behind Caddy).
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# ─── Media storage ───────────────────────────────────────────────────────
# "local" stores files under ./storage and serves them from /media. Use "s3" in production.
# With S3 (or R2, B2...), the key needs read, write and delete access: files are removed from the
# bucket when the messages, posts, channels or communities that used them are deleted.
STORAGE_DRIVER=local
MEDIA_BASE_URL=http://localhost:3000/media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=magnox
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Email ───────────────────────────────────────────────────────────────
# Leave SMTP_URL empty to print emails to the console (development).
SMTP_URL=
EMAIL_FROM="Magnox <no-reply@magnox.local>"
REQUIRE_EMAIL_VERIFICATION=false

# ─── OAuth providers (enabled when both values are set) ─────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Game servers ────────────────────────────────────────────────────────
# NEVER enable in production: lets the poller query private/loopback addresses (for test fixtures).
SERVER_QUERY_ALLOW_PRIVATE=false
# Tests only: point Roblox listings at the fixture server instead of Roblox's API.
# ROBLOX_API_URL=http://127.0.0.1:25591/roblox
# Optional Cloudflare Turnstile "are you human?" check on sign-up, sign-in, password resets and
# server votes. Create a widget at dash.cloudflare.com → Turnstile; leave empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Payments (Stripe) ───────────────────────────────────────────────────
# Community plans (Plus, Pro) sold on /store. Leave the key empty to turn payments off.
# 1. dashboard.stripe.com → Developers → API keys: the secret key (sk_live_... or sk_test_...).
# 2. Product catalogue: a "Plus" and a "Pro" product, each with a monthly and a yearly
#    recurring price; paste the four price ids (price_...) below.
# 3. Developers → Webhooks: add https://YOUR-DOMAIN/api/stripe/webhook with the events
#    checkout.session.completed and customer.subscription.created/updated/deleted, then paste
#    its signing secret (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Tests only: point Stripe at the fixture server (http://127.0.0.1:25591).
# STRIPE_API_URL=

# ─── Voice channels (LiveKit) ────────────────────────────────────────────
# Voice runs on a self-hosted LiveKit server (the "livekit" service in docker-compose.yml,
# started with --profile voice or COMPOSE_PROFILES=voice). Leave the key empty to turn voice off.
# Generate with: openssl rand -hex 8 (key) and openssl rand -hex 32 (secret).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where browsers connect (ws:// or wss://). Empty: this site's own address, which Caddy passes on
# to LiveKit (/rtc). Local development without Caddy: ws://localhost:7880
LIVEKIT_URL=
# Where the app reaches LiveKit's API. Docker sets http://livekit:7880.
LIVEKIT_API_URL=http://localhost:7880
# Docker only: the IP browsers send audio to. Found automatically on a server with a public IP;
# on a home network, set the server's LAN IP and turn off the automatic lookup.
# LIVEKIT_NODE_IP=192.168.1.50
# LIVEKIT_USE_EXTERNAL_IP=false

# ─── Platform ────────────────────────────────────────────────────────────
# Comma-separated emails that are platform admins (once confirmed), with the /admin console.
# Or run: pnpm --filter @magnox/db admin:grant you@example.com
PLATFORM_ADMIN_EMAILS=
# Shown on the Terms and Privacy pages for questions and data requests.
CONTACT_EMAIL=
# Push notifications on phones and computers (Web Push). Make a key pair with
# `npx web-push generate-vapid-keys`; leave blank to turn push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
LOG_LEVEL=info
# Development/e2e only: disables auth and API rate limits. Refused in production.
DISABLE_RATE_LIMITS=false
WORKER_HEALTH_PORT=3002

# ─── Custom domains (optional) ──────────────────────────────────────────
# What communities point their own domains at (default: APP_URL's host), and the DNS resolvers
# used to check them (default: the server's).
CUSTOM_DOMAIN_TARGET=
DNS_SERVERS=

# ─── Backups (scripts/linux/backup.sh) ──────────────────────────────────
# BACKUP_DIR=/srv/magnox-backups
# BACKUP_KEEP=14
# BACKUP_RCLONE_REMOTE=r2:magnox-backups

# ─── Error reporting and tracing (optional, off when blank) ─────────────
# Sentry: errors from the web app, realtime server, worker and browsers. Personal data, cookies,
# headers and request bodies aren't sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Share of requests to trace for Sentry performance (0 to 1).
SENTRY_TRACES_SAMPLE_RATE=0
# OpenTelemetry traces (OTLP over HTTP) to a collector, e.g. http://otel-collector:4318.
# OTEL_EXPORTER_OTLP_HEADERS works too (e.g. an API key for a hosted service).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=magnox
OTEL_TRACES_SAMPLE_RATE=1
