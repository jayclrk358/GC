# Keep LF line endings on every platform (Prettier expects LF; Windows Git would convert to CRLF).
* text=auto eol=lf
# cmd.exe needs CRLF in batch files.
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
