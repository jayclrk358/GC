{
	# Browsers send no server name (SNI) when the site is reached by IP address; use the site's.
	default_sni {$SITE_ADDRESS}
}

# App and realtime share one origin so the session cookie reaches Socket.IO with no CORS setup.
{$SITE_ADDRESS} {
	encode zstd gzip

	@socket path /socket.io/*
	reverse_proxy @socket realtime:3001

	reverse_proxy web:3000
}

# User uploads are served from a separate, cookie-less origin.
{$MEDIA_ADDRESS} {
	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; sandbox"
		Cross-Origin-Resource-Policy cross-origin
		-Server
	}
	# Uploads and their smaller copies (u/<id>-sm.webp, u/<id>-md.webp). Files never change once
	# written, so they're cached for good; misses aren't, so a copy made later still shows up.
	@allowed path_regexp ^/u/[a-z0-9]{8,40}(-(sm|md))?\.(webp|png|jpg|gif|mp4|webm)$
	handle @allowed {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-store"
		respond 404
	}
	handle_errors {
		header Cache-Control "no-store"
		respond "Not found" 404
	}
}
