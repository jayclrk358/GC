{
	# Browsers send no server name (SNI) when the site is reached by IP address; use the site's.
	default_sni {$SITE_ADDRESS}
	# Communities' own domains get a certificate on their first visit, but only once Magnox has
	# verified them (the web app answers 200 for those).
	on_demand_tls {
		ask http://web:3000/api/domains/check
	}
}

# Where requests for the app go: the web app and realtime server on this machine, or spread over
# several servers (CADDY_UPSTREAMS=cluster, see "Several servers" in the README).
import /etc/caddy/upstreams-{$CADDY_UPSTREAMS:single}.caddy

# Request bodies are capped here, before anything reads them: uploads at the largest video a
# plan allows plus the form around it (the app checks each plan's limit), everything else well
# above what any form or webhook sends.
(body_limits) {
	@upload path /api/uploads /api/uploads/*
	request_body @upload {
		max_size 160MB
	}
	@not_upload not path /api/uploads /api/uploads/*
	request_body @not_upload {
		max_size 15MB
	}
}

# App and realtime share one origin so the session cookie reaches Socket.IO with no CORS setup.
{$SITE_ADDRESS} {
	encode zstd gzip
	import body_limits

	handle /socket.io/* {
		import realtime_upstream
	}

	# Voice: LiveKit's signalling (the audio itself goes straight to LiveKit's UDP port). LiveKit
	# runs next to Caddy, or on an app server when there are several servers.
	@voice path /rtc /rtc/*
	handle @voice {
		reverse_proxy {$LIVEKIT_UPSTREAM:livekit:7880}
	}

	handle {
		import web_upstream
	}
}

# User uploads are served from a separate, cookie-less origin.
{$MEDIA_ADDRESS} {
	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; sandbox"
		Cross-Origin-Resource-Policy cross-origin
		-Server
	}
	# Uploads and their smaller copies (u/<id>-sm.webp, u/<id>-md.webp). Files never change once
	# written, so they're cached for good; misses aren't, so a copy made later still shows up.
	@allowed path_regexp ^/u/[a-z0-9]{8,40}(-(sm|md))?\.(webp|png|jpg|gif|mp4|webm)$
	handle @allowed {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-store"
		respond 404
	}
	handle_errors {
		header Cache-Control "no-store"
		respond "Not found" 404
	}
}

# Communities' own domains (Settings → Custom domain). The web app shows the community's pages
# there and sends everything else to the main site.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	import body_limits

	# Only the domain the certificate was issued for, which on-demand TLS already checked with
	# the app: a request naming any other host is turned away here, not looked up by the app.
	# (Like the global strict_sni_host option, but that would also refuse the main site when it's
	# reached by IP address, where browsers send no server name.)
	@misdirected not host {http.request.tls.server_name}
	respond @misdirected "Misdirected request" 421 {
		close
	}

	handle /socket.io/* {
		import realtime_upstream
	}

	handle {
		import web_upstream
	}
}
