{
  "name": "@gamecentral/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "admin:grant": "tsx src/grant-admin.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed/index.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@gamecentral/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
